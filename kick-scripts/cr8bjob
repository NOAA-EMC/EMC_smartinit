#!/bin/ksh
#================================================================================
#  Create Bjob header
#================================================================================
typeset -Z2 jfhr
job=$1
jfhr=$2
# Create J{MDL}_SMINIT job
  echo "#BSUB -J ${job}"             >bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -oo /stmpp1/${USER}/${modeld}.${model_ver}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -eo /stmpp1/${USER}/${modeld}.${model_ver}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -n 1"                >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -W ${WALLCLK}"       >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -P NAM-T2O"             >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -q dev"              >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -R "span[ptile=1]""    >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -R "rusage[mem=6000]"" >>bjobcards-dev${RUNTYP}-$jfhr
 
#cat bjobcards-dev${RUNTYP}-$jfhr  ${jobd}/J${MDL}_SMINIT.test  > J${MDL}_SMINIT.${RUNTYP}
cat bjobcards-dev${RUNTYP}-$jfhr  ${jobd}/J${MDL}_SMINIT  > J${MDL}_SMINIT.${RUNTYP}
rm -f bjobcards-dev${RUNTYP}-$jfhr
