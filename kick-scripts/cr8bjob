#!/bin/ksh
#================================================================================
#  Create Bjob header
#================================================================================
job=$1
ffhr=$2
# Create J{MDL}_SMINIT job
  echo "#BSUB -J ${job}"             >bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -oo /stmpp1/${USER}/${modeld}.${model_ver}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -eo /stmpp1/${USER}/${modeld}.${model_ver}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -n 1"                >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -W ${WALLCLK}"       >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -P RTMA"             >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -q dev"              >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -R "span[ptile=1]""    >>bjobcards-dev${RUNTYP}-$ffhr
  echo "#BSUB -R "rusage[mem=6000]"" >>bjobcards-dev${RUNTYP}-$ffhr
 
cat bjobcards-dev${RUNTYP}-$ffhr ${jobd}/J${MDL}_SMINIT > J${MDL}_SMINIT.${RUNTYP}
rm -f bjobcards-dev${RUNTYP}-$ffhr
