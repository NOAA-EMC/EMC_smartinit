#!/bin/ksh
#================================================================================
#  Create Bjob header
#================================================================================
typeset -Z2 jfhr
job=$1
jfhr=$2
# Create J{MDL}_SMINIT job
  echo "#BSUB -J ${job}"             >bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -o /gpfs/dell2/ptmp/${USER}/${modeld}.${nam_smartinit_ver}/${PDY}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -e /gpfs/dell2/ptmp/${USER}/${modeld}.${nam_smartinit_ver}/${PDY}/${cyc}/list/o${job}" >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -n 12"                >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -W ${WALLCLK}"       >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -P RTMA-T2O"             >>bjobcards-dev${RUNTYP}-$jfhr
# echo "#BSUB -q debug"              >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -q dev"              >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -R "span[ptile=12]""    >>bjobcards-dev${RUNTYP}-$jfhr
# echo "#BSUB -R affinity[core(1)]"    >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -R affinity[core(1):distribute=balance]"    >>bjobcards-dev${RUNTYP}-$jfhr
# echo "#BSUB -R "rusage[mem=10000]"" >>bjobcards-dev${RUNTYP}-$jfhr
  echo "#BSUB -x"                       >>bjobcards-dev${RUNTYP}-$jfhr
 
  echo ". /usrx/local/prod/lmod/lmod/init/profile"     >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module purge"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load EnvVars/1.0.3"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load lsf/10.1"               >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load ips/18.0.1.163"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load impi/18.0.1"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load emc-utils/1.0.0"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load prod_util/1.1.6"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load prod_envir/1.1.0"                      >>bjobcards-dev${RUNTYP}-$jfhr
  echo "module load grib_util/1.0.6"               >>bjobcards-dev${RUNTYP}-$jfhr

#cat bjobcards-dev${RUNTYP}-$jfhr  ${jobd}/J${MDL}_SMINIT.test  > J${MDL}_SMINIT.${RUNTYP}
cat bjobcards-dev${RUNTYP}-$jfhr  ${jobd}/J${MDL}_SMINIT  > J${MDL}_SMINIT.${RUNTYP}
rm -f bjobcards-dev${RUNTYP}-$jfhr
