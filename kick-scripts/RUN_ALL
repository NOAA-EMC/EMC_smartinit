#!/bin/ksh
set -xa
export PATH=${PATH}:.
export stutil=/hwrf/noscrub/soft/modulefiles
. /usrx/local/Modules/3.2.9/init/ksh
module load ibmpe lsf ics
module use $stutil
module load ruby emc-utils
module load GrADS/2.0.2

#=======================================================
# Driving script to run a smartinit domain
# Called by DRIVER
# Submits J{MDL}_SMINIT.${RUNTYP}
# RUNTYP : conus ak alaskanest hi pr conusnest2p5 aknest3
#
# Uses ${cfgdir}/smart_para_config --> directory config
# Jeff McQueen       01/29/2013
# Vertical structure 08/27/2013
#=======================================================
typeset -Z2 cyc #ffhr fhrnxt ffhrsv HHold strhr

#====================User Sets=======================================
# Location of smart config file to set up directories
cfgdir=${rootd}/parm
export wkdir=${rootd}/working
mkdir -p $wkdir
gemdir=/meso/save/$USER/gempak/sfcplot/smart
export utilscript=${utilscript:-/nwprod/util/ush}

export jobd=${jobd:-`pwd`}

subint=0                  # flag to submit intermediate hour forecasts (see below)

export INCR=${INCR:-03}
export MDL=`echo $mdl |tr '[a-z]'  '[A-Z]' `
export NET=$mdl 
if [ $RUNTYP = guam ];then export NET=hiresw;fi

export WALLCLK="1:00"  #TEST
if [ $RUNTYP = conusnest2p5 ];then export WALLCLK="2:00";fi  #TEST

runreg=$RUNTYP
case $RUNTYP in 
    conusnest2p5 ) runreg=conus2p5;;
      alaskanest ) runreg=alaska;;
         aknest3 ) runreg=ak3;;
         dgex_ak ) runreg=ak;;
         dgex_cs ) runreg=conus;;
esac

#================END User Sets=======================================

export ffhr=$fhrstr
export DATA_IN=/stmpp2/${USER}/${modeld}.${model_ver}/${cyc}
mkdir -p $DATA_IN
mkdir -p $DATA_IN/list

while [ $ffhr -le $ENDHRS ];do
  if [ $ffhr -lt 10 ];then ffhr="0"${ffhr};fi
  cd ${wkdir}
  export job="DNG${cyc}.${RUNTYP}-${ffhr}"

# Create and invoke config file needed by Job 
  echo "export RUNTYP=$RUNTYP"   >$wkdir/dng_para_config${RUNTYP}
  echo "export cyc=$cyc"        >>$wkdir/dng_para_config${RUNTYP}
  echo "export RM_TMPDIR=NO"    >>$wkdir/dng_para_config${RUNTYP}
  echo "export mdl=$mdl"        >>$wkdir/dng_para_config${RUNTYP}
  echo "export NET=$mdl"        >>$wkdir/dng_para_config${RUNTYP}
  echo "export RUN=$mdl"        >>$wkdir/dng_para_config${RUNTYP}

#TEST ****   cat $cfgdir/smart_para_test  >>$wkdir/dng_para_config${RUNTYP}

  cat $cfgdir/smart_para_config  >>$wkdir/dng_para_config${RUNTYP}
  chmod 755 ${wkdir}/dng_para_config${RUNTYP}
 . ${wkdir}/dng_para_config${RUNTYP} >dngcfg.out

  export PDY=`/nwprod/util/exec/ndate |cut -c 1-8`
#  export PDY=20150810 ###TEST

  cp -p ${rootd}/docs/${modeld}.ver ${wkdir}
  echo;echo `date`

# 6 hr interval forecasts use 6 hour old smart files so
# wait until old smart file is created 
  if [ $subint -eq 0 ];then 

#   Submit the intermediate hour forecasts while waiting for 6/12 hr files
    ffhrsv=$ffhr
    fhrnxt=$ffhr
    while [ $fhrnxt -le $ENDHRS ];do
      chk6=`expr $fhrnxt % 6`
      if [ $chk6 -ne 0 -o $fhrnxt -eq $fhrstr ];then
        export job="DNG${cyc}.${RUNTYP}-${fhrnxt}"
        echo "export ffhr=$fhrnxt" >> ${wkdir}/dng_para_config${RUNTYP}
        echo "export DATA=${DATA_IN}/${job}"  >>$wkdir/dng_para_config${RUNTYP}
        . ${wkdir}/dng_para_config${RUNTYP} >dngcfg.out
        sleep 10

        echo `date +%T` $MDL SUBMIT SMINIT JOB :  $RUNTYP CYCLE $cyc FHRNXT $fhrnxt
        ${kickd}/cr8bjob $job $fhrnxt
        bsub < J${MDL}_SMINIT.${RUNTYP}

      fi
      ((fhrnxt=fhrnxt+INCR))
      if [ $fhrnxt -lt 10 ];then fhrnxt="0"${fhrnxt};fi
    done
    export INCR=06
    export ffhr=$ffhrsv
    subint=1
  fi 

  wait=0
  while [ $wait -le 3600 -a $ffhr -ge $((fhrstr+06)) ];do
    ((HHold=ffhr-6))
    if [ $HHold -lt 10 ];then HHold="0"${HHold};fi
    smflold=${COM_OUT}/$mdl.$PDY/$mdl.t${cyc}z.smart${runreg}${HHold}.tm00

    if [ ! -s $smflold ];then
      echo  $wait `date +%T` Waiting for $smflold   FFHR=$ffhr
      sleep 60
      ((wait=wait+60))
    else
      ((HHold=ffhr-3))
      if [ $HHold -lt 10 ];then HHold="0"${HHold};fi
      smflold=${COM_OUT}/$mdl.$PDY/$mdl.t${cyc}z.smart${runreg}${HHold}.tm00
      if [ ! -s $smflold ];then
        echo  $wait `date +%T` Waiting for $smflold   FFHR=$ffhr
        sleep 60
        ((wait=wait+60))
      else
        export job="DNG${cyc}.${RUNTYP}-${ffhr}"
        echo "export ffhr=$ffhr" >> ${wkdir}/dng_para_config${RUNTYP}
        echo "export DATA=${DATA_IN}/${job}" >>$wkdir/dng_para_config${RUNTYP}
        . ${wkdir}/dng_para_config${RUNTYP} >dngcfg.out
        echo  $wait `date +%T` SUBMIT $MDL SMINIT JOB :  $RUNTYP CYCLE $cyc FFHR $ffhr
        sleep 10     
        ${kickd}/cr8bjob $job $ffhr
        bsub -K < J${MDL}_SMINIT.${RUNTYP}
        break
      fi
    fi
  done

  ((ffhr=ffhr+INCR))
done

#TEST rm $wkdir/JNAM_SMINIT.$RUNTYP
#TEST rm $wkdir/dng_para_config${RUNTYP}
rm -f $wkdir/bjobcards-dev$RUNTYP*

#echo SUBMIT plotmet.job for $RUNTYP $cyc from fhrs $ffhr to $ENDHRS
export RUNTYP=$RUNTYP
export cyc=$cyc
export strhr=$fhrstr
#bsub < $gemdir/plotmet.job

export PDY=$PDY
export cyc=$cyc
date
plotdir=/meso/save/Annette.Gibbs/plot_smartgrids_divmin

if [ $runreg = ak3 ];then
 bsub < $plotdir/run_webpage00_ak3_grib2_hourly_wox
fi
