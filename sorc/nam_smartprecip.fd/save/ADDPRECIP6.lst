          1 |       PROGRAM ADDPRECIP6
          2 |C                .      .    .                                       .
          3 |C SUBPROGRAM:    ADDPRECIP12
          4 |C   PRGMMR: MANIKIN        ORG: W/NP22     DATE:  07-03-07
          5 |C
          6 |C ABSTRACT: PRODUCES 12-HOUR TOTAL AND CONVECTIVE PRECIPITATION BUCKETS
          7 |C              AS WELL AS SNOWFALL ON THE ETA NATIVE GRID FOR SMARTINIT
          8 |C
          9 |C PROGRAM HISTORY LOG:
         10 |C   07-03-07  GEOFF MANIKIN
         11 |C
         12 |C REMARKS:
         13 |
         14 |C ATTRIBUTES:
         15 |C   LANGUAGE: FORTRAN-90
         16 |C   MACHINE:  CRAY C-90
         17 |C$$$
         18 |      INCLUDE "parmnam"
  1       1 |      PARAMETER(ILIM=954,JLIM=835,MAXLEV=60)
         19 |      PARAMETER(ITOT=ILIM*JLIM)
         20 |      DIMENSION GRID(ITOT),DIFF(5)
         21 |      DIMENSION INCDAT(8),JNCDAT(8)
         22 |      INTEGER JPDS(200),JGDS(200),KPDS(200),KGDS(200)
         23 |      INTEGER LEVS(MAXLEV),IVAR(5)
         24 |      INTEGER FHR1, FHR2, FHR3
         25 |      LOGICAL*1 MASK(ITOT), MASK2(ITOT)
         26 |C
         27 |      PARAMETER(MBUF=2000000,JF=1000000)
         28 |      CHARACTER CBUF(MBUF)
         29 |      CHARACTER CBUF2(MBUF)
         30 |      CHARACTER*11 ENVVAR
         31 |      CHARACTER*80 FNAME
         32 |      LOGICAL*1 LB(JF)
         33 |      REAL F(JF)
         34 |      PARAMETER(MSK1=32000,MSK2=4000)
         35 |      INTEGER JENS(200),KENS(200)
         36 |      DIMENSION APCP(ITOT), APCP2(ITOT),APCP6HR(ITOT),
         37 |     &     CAPCP(ITOT),CAPCP2(ITOT),CAPCP6HR(ITOT),
         38 |     &     SNOW(ITOT),SNOW2(ITOT),SNOW6HR(ITOT)
         39 |C
         40 |      READ (5,*) FHR1, FHR2
         41 |      NUMLEV=MAXLEV
         42 |      FHR3=FHR1-3
         43 |      print *, 'fhr1 fhr2 fhr3 ', FHR1, FHR2, FHR3
         44 |C
         45 |      LUGB=13
         46 |      LUGI=14
         47 |      LUGB2=15
         48 |      LUGI2=16
         49 |      LUGB3=50
         50 |      LUGB4=51
         51 |      LUGB5=52
         52 |C
         53 |      JJ1 = 1
         54 |      JJINC = 1
         55 |C
         56 |      ISTAT = 0
         57 |C
         58 |C  READ INDEX FILE TO GET GRID SPECS
         59 |C
         60 |      IRGI = 1
         61 |      IRGS = 1
         62 |      KMAX = 0
         63 |      JR=0
         64 |      KSKIP = 0
         65 |      ENVVAR='XLFUNIT_   '
         66 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB
         67 |      CALL GETENV(ENVVAR,FNAME)
         68 |      CALL BAOPEN(LUGB,FNAME,IRETGB)
         69 |      ENVVAR='XLFUNIT_   '
         70 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGI
         71 |      CALL GETENV(ENVVAR,FNAME)
         72 |      CALL BAOPEN(LUGI,FNAME,IRETGI)
         73 |      CALL GETGI(LUGI,KSKIP,MBUF,CBUF,NLEN,NNUM,IRGI)
         74 |      write(6,*)' IRET FROM GETGI ',IRGI
         75 |      IF(IRGI .NE. 0) THEN
         76 |        WRITE(6,*)' PROBLEMS READING GRIB INDEX FILE SO ABORT'
         77 |        ISTAT = IRGI
         78 |        RETURN
         79 |      ENDIF
         80 |c      REWIND LUGI
         81 |
         82 |C
         83 |      DO K = 1, NNUM
         84 |        JR = K - 1
         85 |        JPDS = -1
         86 |        JGDS = -1
         87 |        CALL GETGB1S(CBUF,NLEN,NNUM,JR,JPDS,JGDS,JENS,
         88 |     &               KR,KPDS,KGDS,KENS,LSKIP,LGRIB,IRGS)
         89 |        write(6,*)' IRET FROM GETGB1S ',IRGS
         90 |        IF(IRGI .NE. 0) THEN
         91 |          WRITE(6,*)' PROBLEMS ON 1ST READ OF GRIB FILE SO ABORT'
         92 |          ISTAT = IRGS
         93 |          RETURN
         94 |        ENDIF
         95 |C
         96 |      ENDDO
         97 |
         98 |C    GET GRID NUMBER FROM PDS
         99 |C
        100 |      IGDNUM = KPDS(3)
        101 |C
        102 |C   PROCESS THE GRIB FILE
        103 |C
        104 |      IMAX = KGDS(2)
        105 |      JMAX = KGDS(3)
        106 |      NUMVAL = IMAX*JMAX
        107 |      KMAX = MAXLEV
        108 |      WRITE(6,280) IMAX,JMAX,NUMLEV,KMAX
        109 |  280 FORMAT(' IMAX,JMAX,NUMLEV,KMAX ',5I4)
        110 |  285 FORMAT(' IV, IVAR, L, IRET:  ',4I5)
        111 |
        112 |C -== GET SURFACE FIELDS ==-
        113 |      L = 0
        114 |      IV= 0
        115 |
        116 |C   PRECIP
        117 |
        118 |c   to start each new file with its index, set J=-1 for sfc pressure
        119 |C
        120 |      J = 0
        121 |      JPDS = -1
        122 |      JPDS(3) = IGDNUM
        123 |      JPDS(5) = 061
        124 |      JPDS(6) = 001
        125 |      JPDS(13) = 1
        126 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        127 |     X           KPDS,KGDS,MASK,GRID,IRET)
        128 |      IF(IRET.EQ.0) THEN
        129 |        II = 1
        130 |        JJ = JJ1
        131 |        DO KK = 1, ITOT
        132 |          APCP(KK) = GRID(KK)
        133 |        ENDDO
        134 |      ELSE
        135 |        WRITE(6,285)IV,JPDS(5),L,IRET
        136 |        WRITE(6,*)' COULD NOT UNPACK PRECIP '
        137 |         ISTAT = IRET
        138 |        RETURN
        139 |      ENDIF
        140 |
        141 |C   PRECIP
        142 |
        143 |C  CONVECTIVE PRECIP
        144 |      J = 0
        145 |      JPDS = -1
        146 |      JPDS(3) = IGDNUM
        147 |      JPDS(5) = 063
        148 |      JPDS(6) = 001
        149 |      JPDS(13) = 1
        150 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        151 |     X           KPDS,KGDS,MASK,GRID,IRET)
        152 |
        153 |      IF(IRET.EQ.0) THEN
        154 |        II = 1
        155 |        JJ = JJ1
        156 |        DO KK = 1, ITOT
        157 |          CAPCP(KK) = GRID(KK)
        158 |        ENDDO
        159 |      ELSE
        160 |        WRITE(6,285)IV,JPDS(5),L,IRET
        161 |        WRITE(6,*)' COULD NOT UNPACK CNVCT PRECIP '
        162 |         ISTAT = IRET
        163 |        RETURN
        164 |      ENDIF
        165 |
        166 |C  SNOWFALL
        167 |      J = 0
        168 |      JPDS = -1
        169 |      JPDS(3) = IGDNUM
        170 |      JPDS(5) = 065
        171 |      JPDS(6) = 001
        172 |      JPDS(14) = FHR3
        173 |      JPDS(15) = FHR1
        174 |
        175 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        176 |     X           KPDS,KGDS,MASK,GRID,IRET)
        177 |      IF(IRET.EQ.0) THEN
        178 |        II = 1
        179 |        JJ = JJ1
        180 |        DO KK = 1, ITOT
        181 |          SNOW(KK) = GRID(KK)
        182 |        ENDDO
        183 |      ELSE
        184 |        WRITE(6,285)IV,JPDS(5),L,IRET
        185 |        WRITE(6,*)' COULD NOT UNPACK SNOW '
        186 |         ISTAT = IRET
        187 |        RETURN
        188 |      ENDIF
        189 |
        190 |C BEGIN WORK ON 2ND FILE
        191 |      JJ1 = 1
        192 |      JJINC = 1
        193 |
        194 |C  READ INDEX FILE TO GET GRID SPECS
        195 |C
        196 |      IRGI = 1
        197 |      IRGS = 1
        198 |      KMAX = 0
        199 |      JR=0
        200 |      KSKIP = 0
        201 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB2
        202 |      CALL GETENV(ENVVAR,FNAME)
        203 |      CALL BAOPEN(LUGB2,FNAME,IRETGB2)
        204 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGI2
        205 |      CALL GETENV(ENVVAR,FNAME)
        206 |      CALL BAOPEN(LUGI2,FNAME,IRETGI2)
        207 |      CALL GETGI(LUGI2,KSKIP,MBUF,CBUF2,NLEN,NNUM,IRGI)
        208 |      IF(IRGI .NE. 0) THEN
        209 |        WRITE(6,*)' PROBLEMS READING GRIB INDEX FILE SO ABORT'
        210 |        ISTAT = IRGI
        211 |        RETURN
        212 |      ENDIF
        213 |c      REWIND LUGI2
        214 |
        215 |      DO K = 1, NNUM
        216 |        JR = K - 1
        217 |        JPDS = -1
        218 |        JGDS = -1
        219 |        CALL GETGB1S(CBUF2,NLEN,NNUM,JR,JPDS,JGDS,JENS,
        220 |     &               KR,KPDS,KGDS,KENS,LSKIP,LGRIB,IRGS)
        221 |        write(6,*)' IRET FROM GETGB1S ',IRGS
        222 |        IF(IRGI .NE. 0) THEN
        223 |          WRITE(6,*)' PROBLEMS ON 1ST READ OF GRIB FILE SO ABORT'
        224 |          ISTAT = IRGS
        225 |          RETURN
        226 |        ENDIF
        227 |C
        228 |      ENDDO
        229 |
        230 |C    GET GRID NUMBER FROM PDS
        231 |C
        232 |      IGDNUM = KPDS(3)
        233 |C
        234 |C   PROCESS THE GRIB FILE
        235 |C
        236 |      IMAX = KGDS(2)
        237 |      JMAX = KGDS(3)
        238 |      NUMVAL = IMAX*JMAX
        239 |      KMAX = MAXLEV
        240 |      WRITE(6,280) IMAX,JMAX,NUMLEV,KMAX
        241 |
        242 |C -== GET SURFACE FIELDS ==-
        243 |      L = 0
        244 |      IV= 0
        245 |C   ACCUMULATED PRECIP
        246 |
        247 |c   to start each new file with its index, set J=-1 for sfc pressure
        248 |C
        249 |C
        250 |      J = -1
        251 |      JPDS = -1
        252 |      JPDS(3) = IGDNUM
        253 |      JPDS(5) = 061
        254 |      JPDS(6) = 001
        255 |      JPDS(13) = 1
        256 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        257 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        258 |      IF(IRET.EQ.0) THEN
        259 |        II = 1
        260 |        JJ = JJ1
        261 |        DO KK = 1, ITOT
        262 |          APCP2(KK) = GRID(KK)
        263 |        ENDDO
        264 |      ELSE
        265 |        WRITE(6,285)IV,JPDS(5),L,IRET
        266 |        WRITE(6,*)' COULD NOT UNPACK PCP 2ND GRID FILE '
        267 |         ISTAT = IRET
        268 |        RETURN
        269 |      ENDIF
        270 |
        271 |C   ACCUMULATED CONVECTIVE PRECIP
        272 |      J = -1
        273 |      JPDS = -1
        274 |      JPDS(3) = IGDNUM
        275 |      JPDS(5) = 063
        276 |      JPDS(6) = 001
        277 |      JPDS(13) = 1
        278 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        279 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        280 |      IF(IRET.EQ.0) THEN
        281 |        II = 1
        282 |        JJ = JJ1
        283 |        DO KK = 1, ITOT
        284 |          CAPCP2(KK) = GRID(KK)
        285 |        ENDDO
        286 |      ELSE
        287 |        WRITE(6,285)IV,JPDS(5),L,IRET
        288 |        WRITE(6,*)' COULD NOT UNPACK CPCP 2ND GRID FILE '
        289 |         ISTAT = IRET
        290 |        RETURN
        291 |      ENDIF
        292 |
        293 |C   SNOWFALL
        294 |      J = -1
        295 |      JPDS = -1
        296 |      JPDS(3) = IGDNUM
        297 |      JPDS(5) = 065
        298 |      JPDS(6) = 001
        299 |      JPDS(14) = FHR1
        300 |      JPDS(15) = FHR2
        301 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        302 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        303 |      IF(IRET.EQ.0) THEN
        304 |        II = 1
        305 |        JJ = JJ1
        306 |        DO KK = 1, ITOT
        307 |          SNOW2(KK) = GRID(KK)
        308 |        ENDDO
        309 |      ELSE
        310 |        WRITE(6,285)IV,JPDS(5),L,IRET
        311 |        WRITE(6,*)' COULD NOT UNPACK SNOW 2ND GRID FILE '
        312 |         ISTAT = IRET
        313 |        RETURN
        314 |      ENDIF
        315 |
        316 |       DO K = 1, ITOT
        317 |          APCP6HR(K)=APCP2(K)+APCP(K)
        318 |          CAPCP6HR(K)=CAPCP2(K)+CAPCP(K)
        319 |          SNOW6HR(K)=SNOW2(K)+SNOW(K)
        320 |       ENDDO
        321 |
        322 |      KPDS(5)=61
        323 |      KPDS(14)=FHR3
        324 |      KPDS(15)=FHR2
        325 |      ENVVAR='XLFUNIT_   '
        326 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB3
        327 |      CALL GETENV(ENVVAR,FNAME)
        328 |      CALL BAOPEN(LUGB3,FNAME,IRET)
        329 |      CALL PUTGB(LUGB3,ITOT,KPDS,KGDS,MASK2,APCP6HR,IRET)
        330 |      CALL BACLOSE(LUGB3,IRET)
        331 |
        332 |      KPDS(5)=63
        333 |      KPDS(14)=FHR3
        334 |      KPDS(15)=FHR2
        335 |      ENVVAR='XLFUNIT_   '
        336 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB4
        337 |      CALL GETENV(ENVVAR,FNAME)
        338 |      CALL BAOPEN(LUGB4,FNAME,IRET)
        339 |      CALL PUTGB(LUGB4,ITOT,KPDS,KGDS,MASK2,CAPCP6HR,IRET)
        340 |      CALL BACLOSE(LUGB4,IRET)
        341 |
        342 |      KPDS(5)=65
        343 |      KPDS(14)=FHR3
        344 |      KPDS(15)=FHR2
        345 |      ENVVAR='XLFUNIT_   '
        346 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB5
        347 |      CALL GETENV(ENVVAR,FNAME)
        348 |      CALL BAOPEN(LUGB5,FNAME,IRET)
        349 |      CALL PUTGB(LUGB5,ITOT,KPDS,KGDS,MASK2,SNOW6HR,IRET)
        350 |      CALL BACLOSE(LUGB5,IRET)
        351 |      STOP
        352 |      END
 
