        117 |  280 FORMAT(' IMAX,JMAX,NUMLEV,KMAX ',5I4)
        118 |  285 FORMAT(' IV, IVAR, L, IRET:  ',4I5)
        119 |
        120 |C -== GET SURFACE FIELDS ==-
        121 |      L = 0
        122 |      IV= 0
        123 |
        124 |C   PRECIP
        125 |
        126 |c   to start each new file with its index, set J=-1 for sfc pressure
