        520 |        WRITE(6,*)' COULD NOT UNPACK CPCP 4TH GRID FILE '
        521 |         ISTAT = IRET
        522 |        RETURN
        523 |      ENDIF
        524 |
        525 |C   SNOWFALL
        526 |      J = -1
        527 |      JPDS = -1
        528 |      JPDS(3) = IGDNUM
        529 |      JPDS(5) = 065
        530 |      JPDS(6) = 001
        531 |      JPDS(14) = FHR3
        532 |      JPDS(15) = FHR4
        533 |      CALL GETGB(LUGB4,LUGI4,NUMVAL,J,JPDS,JGDS,KF,K,
        534 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        535 |      IF(IRET.EQ.0) THEN
        536 |        II = 1
        537 |        JJ = JJ1
        538 |        DO KK = 1, ITOT
        539 |          SNOW4(KK) = GRID(KK)
        540 |        ENDDO
        541 |      ELSE
        542 |        WRITE(6,285)IV,JPDS(5),L,IRET
        543 |        WRITE(6,*)' COULD NOT UNPACK SNOW 4TH GRID FILE '
        544 |         ISTAT = IRET
        545 |        RETURN
        546 |      ENDIF
        547 |
        548 |       DO K = 1, ITOT
        549 |          APCP12HR(K)=APCP1(K)+APCP2(K)+APCP3(K)+APCP4(K)
        550 |          CAPCP12HR(K)=CAPCP1(K)+CAPCP2(K)+CAPCP3(K)+CAPCP4(K)
        551 |          SNOW12HR(K)=SNOW1(K)+SNOW2(K)+SNOW3(K)+SNOW4(K)
        552 |       ENDDO
        553 |
        554 |      KPDS(5)=61
        555 |      KPDS(14)=FHR0
        556 |      KPDS(15)=FHR4
        557 |      ENVVAR='XLFUNIT_   '
        558 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB5
        559 |      CALL GETENV(ENVVAR,FNAME)
        560 |      CALL BAOPEN(LUGB5,FNAME,IRET)
        561 |      CALL PUTGB(LUGB5,ITOT,KPDS,KGDS,MASK2,APCP12HR,IRET)
        562 |      CALL BACLOSE(LUGB5,IRET)
        563 |
        564 |      KPDS(5)=63
        565 |      KPDS(14)=FHR0
        566 |      KPDS(15)=FHR4
