         37 |     &     APCP4(ITOT),APCP12HR(ITOT)
         38 |      DIMENSION CAPCP1(ITOT),CAPCP2(ITOT),CAPCP3(ITOT),
         39 |     &     CAPCP4(ITOT),CAPCP12HR(ITOT)
         40 |      DIMENSION SNOW1(ITOT),SNOW2(ITOT),SNOW3(ITOT),
         41 |     &     SNOW4(ITOT),SNOW12HR(ITOT)
         42 |
         43 |C
         44 |      READ (5,*) FHR1, FHR2, FHR3, FHR4
         45 |      print *, 'fhr1 fhr2 fhr3 fhr4 ', FHR1, FHR2, FHR3, FHR4
         46 |      FHR0=FHR1-3
         47 |      NUMLEV=MAXLEV
         48 |C
         49 |      LUGB=13
         50 |      LUGI=14
         51 |      LUGB2=15
         52 |      LUGI2=16
         53 |      LUGB3=17
         54 |      LUGI3=18
         55 |      LUGB4=19
         56 |      LUGI4=20
         57 |      LUGB5=50
         58 |      LUGB6=51
         59 |      LUGB7=52
         60 |C
         61 |      JJ1 = 1
         62 |      JJINC = 1
         63 |C
         64 |      ISTAT = 0
         65 |C
         66 |C  READ INDEX FILE TO GET GRID SPECS
         67 |C
         68 |      IRGI = 1
         69 |      IRGS = 1
         70 |      KMAX = 0
         71 |      JR=0
         72 |      KSKIP = 0
         73 |      ENVVAR='XLFUNIT_   '
         74 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB
         75 |      CALL GETENV(ENVVAR,FNAME)
         76 |      CALL BAOPEN(LUGB,FNAME,IRETGB)
         77 |      ENVVAR='XLFUNIT_   '
         78 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGI
         79 |      CALL GETENV(ENVVAR,FNAME)
         80 |      CALL BAOPEN(LUGI,FNAME,IRETGI)
         81 |      CALL GETGI(LUGI,KSKIP,MBUF,CBUF,NLEN,NNUM,IRGI)
         82 |      write(6,*)' IRET FROM GETGI ',IRGI
         83 |      IF(IRGI .NE. 0) THEN
         84 |        WRITE(6,*)' PROBLEMS READING GRIB INDEX FILE SO ABORT'
         85 |        ISTAT = IRGI
         86 |        RETURN
         87 |      ENDIF
         88 |c      REWIND LUGI
         89 |
         90 |C
         91 |      DO K = 1, NNUM
         92 |        JR = K - 1
         93 |        JPDS = -1
         94 |        JGDS = -1
         95 |        CALL GETGB1S(CBUF,NLEN,NNUM,JR,JPDS,JGDS,JENS,
         96 |     &               KR,KPDS,KGDS,KENS,LSKIP,LGRIB,IRGS)
         97 |        write(6,*)' IRET FROM GETGB1S FILE 1',IRGS
         98 |        IF(IRGI .NE. 0) THEN
         99 |          WRITE(6,*)' PROBLEMS ON 1ST READ OF GRIB FILE SO ABORT'
        100 |          ISTAT = IRGS
        101 |          RETURN
        102 |        ENDIF
        103 |C
        104 |      ENDDO
        105 |
        106 |C    GET GRID NUMBER FROM PDS
        107 |C
        108 |      IGDNUM = KPDS(3)
