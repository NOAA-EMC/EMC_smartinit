export RUN_ENVIR=dev
export envir=prod
#export prodenvir=canned # location of nam/sref data: prod, para, test, or canned

#####################################################################################
# This block is for Developer's test run:
# Run config file to get input parameters
# This config file should define the following variables
# DATA_IN: Location of working directory, default to /tmpnwprd
# SENDECF: If the job is to be running using SMS, default to YES
# SENDDBN: Set to NO for developers, default to YES
# COM_IN:  Directory for input files, default to /com/$NET/${envir}
# COM_OUT: Directory for output file, default to /com/$NET/${envir}
# gespath: Directory for the guess or restart files, default to /nwges/${envir}
#
#  USED BY RUN_ALL JOB to set up Development input and output file directies
#####################################################################################
export SENDECF=NO
export SENDDBN=NO
export SENDDBN_GB2=NO
export DBNROOT=/nwprod/spa_util/para_dbn
export KEEPDATA=${KEEPDATA:-%KEEPDATA:YES%}
export rrfs_ver=v1.0

export HOMEsmartinit=/lfs/h2/emc/da/save/$USER/packages/smartinit.${rrfs_smartinit_ver}_test # dng software root dir
echo HOMEsmartinit $HOMEsmartinit

export COM_INrrfs=/lfs/h2/emc/ptmp/emc.lam/com/rrfs/${rrfs_ver}
export COMINrrfs=/lfs/h2/emc/ptmp/emc.lam/com/rrfs/${rrfs_ver}/${RUN}.${PDY}
export DATA_IN=/lfs/h2/emc/ptmp/$USER/smartinit.${rrfs_smartinit_ver}_test/$PDY/$cyc
export DATAROOT=/lfs/h2/emc/ptmp/$USER/smartinit.${rrfs_smartinit_ver}_test/$PDY/$cyc

export COMOUT=/lfs/h2/emc/ptmp/$USER/${envir}/${NET}/${smartinit_ver}_test/${RUN}.${PDY}
export jlogfile=${COM_OUT}/jlogfile.`date +%Y%m%d`
