#%Module######################################################################
##                                                       Annette.Gibbs@noaa.gov
##                                                           NOAA/NWS/NCEP/EMC
## SMARTINIT v4.1.0
##_____________________________________________________
proc ModulesHelp { } {
puts stderr "Set environment veriables for SMARTINIT"
puts stderr "This module initializes the enviro nment "
puts stderr "for the Intel Compiler Suite $version\n"
}
module-whatis " SMARTINIT whatis description"

set ver v4.1.0

set sys [uname sysname]
#set SMARTINIT /nwprod2/modulefiles/SMARTINIT
#set SMARTINIT /nwpara2/modulefiles/NAM_SMARTINIT
set SMARTINIT /u/Annette.Gibbs/modulefiles/SMARTINIT
#set SMARTINIT /nwprod2/modulefiles/NAM_SMARTINIT
set lname SMARTINIT

# Known conflicts ???
conflict bacio/v2.0.0
conflict w3nco/v2.0.5
conflict ics/14.1
conflict ics/15.0.1

# Loading Intel Compiler Suite
module load ics/12.1

### is ibmpe needed?  Seems needed for ARW, but kills NMMB build 
module load ibmpe

# Loading nceplibs modules
module load ip/v2.0.0
module load bacio/v2.0.1
module load w3nco/v2.0.6
module load w3emc/v2.2.0

module load g2/v2.5.2
module load g2tmpl/v1.4.0
module load jasper/v1.900.1
module load png/v1.2.44
module load z/v1.2.6

module load bufr/v10.2.5
module load sp/v2.0.2
module load transutil/v1.0.0

setenv COMP ifort
setenv COMP_MP mpfort
setenv COMP_MPI mpiifort

setenv C_COMP icc
setenv C_COMP_MP mpcc

