#!/bin/ksh --login

#BSUB -J ftpmet
#BSUB -oo /stmp/Jeff.McQueen/smartplt/list/plsiftp.out
#BSUB -eo /stmp/Jeff.McQueen/smartplt/list/plsiftp.out  
#BSUB -n 1
#BSUB -W 01:00
#BSUB -q transfer
#BSUB -R span[ptile=1]
#BSUB -R affinity[core]
#BSUB -R rusage[mem=200]
#BSUB -P RTMA     
export envir=dev

# set -x 
#===========================================================
# ftpmet.job:  script to ftp gempak plots    
# Calls: 
# Jeff McQueen 12/12
#===========================================================

export can=d2
export incr=$INCR
 export iftp=1
#The Following CAN BE SET in RUN_ALL or RUN_GEM
if [ -z "$ymd" ];then
 export ymd=`/nwprod/util/exec/ndate |cut -c 1-8`
 export reg="hi hi"
 export cyc=12
 export strhr=03
 export endhrs=12
 export incr=03
 export plotarea=dset
 export mdld=nam
fi
set -A reg ${reg}

export rootd=/meso/save/$USER/gempak

if [ $plotarea = dset ];then
  set -A drt ${reg[*]}
else
  set -A drt $plotarea $plotarea
fi 
set -A mdld ${mdld[*]}

export wkdir1=/stmp/$USER/smartplt/${mdld}${drt[0]}${cyc}
export wkdir2=/stmp/$USER/smartplt/${can}${mdld}${drt[0]}${cyc}
export wkdifdir=/stmp/$USER/smartplt/gemdif${mdld}${drt[0]}  

echo
echo "===========================================================================
echo FTP smartinit Model plots for cycle $cyc $ymd $strhr to $endhrs hrs
echo REGION ${drt} DIR HDR $can  
echo "===========================================================================
echo ftpmet.job wkdir1 $wkdir1
echo ftpmet.job wkdir2 $wkdir2
echo ftpmet.job wkdifdir $wkdifdir

export scrdir=${rootd}/sfcplot/smart 
export webrt=/home/people/emc/www/htdocs/mmb/aq/smart

#===========================USER SETS===================================
typeset -Z2 cyc avghr 

  let fhr=$strhr
  ssh wd22jm@emcrzdm.ncep.noaa.gov "mkdir -p $webrt/$ymd$cyc/" >sm.out 2>&1
  while [ $fhr -le $endhrs ];do 
    if [ $fhr -lt 10 ];then fhr=0${fhr};fi
    echo;echo $ymd $cyc FHR= $fhr  

#   SCP all gif files for current variable plots to web
    if [ $iftp -eq 1 ];then
      if [ -s $wkdir1 ];then
        cd $wkdir1
        scp -p *${fhr}.gif wd22jm@emcrzdm.ncep.noaa.gov:$webrt/$ymd$cyc >sm.out 2>&1
      else
        echo PLOT DIR $wkdir1 NOT FOUND
      fi
 
      if [ -s $wkdir2 ];then
        cd $wkdir2
        echo `pwd`;ls *${fhr}.gif
        chmod 755 *${fhr}.gif
        scp -p *${fhr}.gif wd22jm@emcrzdm.ncep.noaa.gov:$webrt/$ymd$cyc >sm.out 2>&1
      else
        echo PLOT DIR $wkdir2 NOT FOUND
      fi

      if [ -s $wkdifdir ];then
        cd $wkdifdir
        echo `pwd`; ls *${fhr}.gif
        chmod 755 *${fhr}.gif
        scp -p *${fhr}.gif wd22jm@emcrzdm.ncep.noaa.gov:$webrt/$ymd$cyc >sm.out 2>&1 
      else
        echo PLOT DIR $wkdifdir NOT FOUND
      fi
    fi
    let fhr=$fhr+$incr
  done
rm -f sm.out
