          1 |       PROGRAM MAKEPRECIP
          2 |C                .      .    .                                       .
          3 |C SUBPROGRAM:    MAKEPRECIP
          4 |C   PRGMMR: MANIKIN        ORG: W/NP22     DATE:  01-10-00
          5 |C
          6 |C ABSTRACT: PRODUCES 3-HOUR TOTAL AND CONVECTIVE PRECIPITATION BUCKETS
          7 |C              ON THE ETA NATIVE GRID FOR SMARTINIT
          8 |C
          9 |C PROGRAM HISTORY LOG:
         10 |C   01-10-00  GEOFF MANIKIN
         11 |C
         12 |C REMARKS:
         13 |
         14 |C ATTRIBUTES:
         15 |C   LANGUAGE: FORTRAN-90
         16 |C   MACHINE:  CRAY C-90
         17 |C$$$
         18 |      INCLUDE "parmnam"
  1       1 |      PARAMETER(ILIM=954,JLIM=835,MAXLEV=60)
         19 |      PARAMETER(ITOT=ILIM*JLIM)
         20 |      DIMENSION GRID(ITOT),DIFF(5)
         21 |      DIMENSION INCDAT(8),JNCDAT(8)
         22 |      INTEGER JPDS(200),JGDS(200),KPDS(200),KGDS(200)
         23 |      INTEGER LEVS(MAXLEV),IVAR(5)
         24 |      INTEGER FHR1, FHR2, FHR12
         25 |      LOGICAL*1 MASK(ITOT), MASK2(ITOT)
         26 |C
         27 |      PARAMETER(MBUF=2000000,JF=1000000)
         28 |      CHARACTER CBUF(MBUF)
         29 |      CHARACTER CBUF2(MBUF)
         30 |      CHARACTER*11 ENVVAR
         31 |      CHARACTER*80 FNAME
         32 |      LOGICAL*1 LB(JF)
         33 |      REAL F(JF)
         34 |      PARAMETER(MSK1=32000,MSK2=4000)
         35 |      INTEGER JENS(200),KENS(200)
         36 |      DIMENSION APCP(ITOT), APCP2(ITOT),APCP3HR(ITOT),
         37 |     &     CAPCP(ITOT),CAPCP2(ITOT),CAPCP3HR(ITOT),
         38 |     &     SNOW(ITOT),SNOW2(ITOT),SNOW3HR(ITOT)
         39 |C
         40 |      READ (5,*) FHR2, FHR1
         41 |      print *, 'makeprecip hours are ', FHR1, FHR2
         42 |      NUMLEV=MAXLEV
         43 |      IF (MOD(FHR2,12).EQ. 0.) THEN
         44 |        FHR3=FHR2-12
         45 |      ELSE
         46 |        FHR3=FHR2-MOD(FHR2,12)
         47 |      ENDIF
         48 |C
         49 |      LUGB=13
         50 |      LUGI=14
         51 |      LUGB2=15
         52 |      LUGI2=16
         53 |      LUGB3=50
         54 |      LUGB4=51
         55 |      LUGB5=52
         56 |C
         57 |      JJ1 = 1
         58 |      JJINC = 1
         59 |C
         60 |      ISTAT = 0
         61 |C
         62 |C  READ INDEX FILE TO GET GRID SPECS
         63 |C
         64 |      IRGI = 1
         65 |      IRGS = 1
         66 |      KMAX = 0
         67 |      JR=0
         68 |      KSKIP = 0
         69 |      ENVVAR='XLFUNIT_   '
         70 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB
         71 |      CALL GETENV(ENVVAR,FNAME)
         72 |      CALL BAOPEN(LUGB,FNAME,IRETGB)
         73 |      ENVVAR='XLFUNIT_   '
         74 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGI
         75 |      CALL GETENV(ENVVAR,FNAME)
         76 |      CALL BAOPEN(LUGI,FNAME,IRETGI)
         77 |      CALL GETGI(LUGI,KSKIP,MBUF,CBUF,NLEN,NNUM,IRGI)
         78 |      write(6,*)' IRET FROM GETGI ',IRGI
         79 |      IF(IRGI .NE. 0) THEN
         80 |        WRITE(6,*)' PROBLEMS READING GRIB INDEX FILE SO ABORT'
         81 |        ISTAT = IRGI
         82 |        RETURN
         83 |      ENDIF
         84 |c      REWIND LUGI
         85 |
         86 |C
         87 |      DO K = 1, NNUM
         88 |        JR = K - 1
         89 |        JPDS = -1
         90 |        JGDS = -1
         91 |        CALL GETGB1S(CBUF,NLEN,NNUM,JR,JPDS,JGDS,JENS,
         92 |     &               KR,KPDS,KGDS,KENS,LSKIP,LGRIB,IRGS)
         93 |        write(6,*)' IRET FROM GETGB1S ',IRGS
         94 |        IF(IRGI .NE. 0) THEN
         95 |          WRITE(6,*)' PROBLEMS ON 1ST READ OF GRIB FILE SO ABORT'
         96 |          ISTAT = IRGS
         97 |          RETURN
         98 |        ENDIF
         99 |C
        100 |      ENDDO
        101 |
        102 |C    GET GRID NUMBER FROM PDS
        103 |C
        104 |      IGDNUM = KPDS(3)
        105 |C
        106 |C   PROCESS THE GRIB FILE
        107 |C
        108 |      IMAX = KGDS(2)
        109 |      JMAX = KGDS(3)
        110 |      NUMVAL = IMAX*JMAX
        111 |      KMAX = MAXLEV
        112 |      WRITE(6,280) IMAX,JMAX,NUMLEV,KMAX
        113 |  280 FORMAT(' IMAX,JMAX,NUMLEV,KMAX ',5I4)
        114 |  285 FORMAT(' IV, IVAR, L, IRET:  ',4I5)
        115 |
        116 |C -== GET SURFACE FIELDS ==-
        117 |      L = 0
        118 |      IV= 0
        119 |
        120 |C   PRECIP
        121 |
        122 |c   to start each new file with its index, set J=-1 for sfc pressure
        123 |C
        124 |      J = 0
        125 |      JPDS = -1
        126 |      JPDS(3) = IGDNUM
        127 |      JPDS(5) = 061
        128 |      JPDS(6) = 001
        129 |      JPDS(13) = 1
        130 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        131 |     X           KPDS,KGDS,MASK,GRID,IRET)
        132 |      IF(IRET.EQ.0) THEN
        133 |        II = 1
        134 |        JJ = JJ1
        135 |        DO KK = 1, ITOT
        136 |          APCP(KK) = GRID(KK)
        137 |        ENDDO
        138 |      ELSE
        139 |        WRITE(6,285)IV,JPDS(5),L,IRET
        140 |        WRITE(6,*)' COULD NOT UNPACK TOT PCP FROM FILE 1'
        141 |         ISTAT = IRET
        142 |        RETURN
        143 |      ENDIF
        144 |
        145 |C   PRECIP
        146 |
        147 |C  CONVECTIVE PRECIP
        148 |      J = 0
        149 |      JPDS = -1
        150 |      JPDS(3) = IGDNUM
        151 |      JPDS(5) = 063
        152 |      JPDS(6) = 001
        153 |      JPDS(13) = 1
        154 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        155 |     X           KPDS,KGDS,MASK,GRID,IRET)
        156 |
        157 |      IF(IRET.EQ.0) THEN
        158 |        II = 1
        159 |        JJ = JJ1
        160 |        DO KK = 1, ITOT
        161 |          CAPCP(KK) = GRID(KK)
        162 |        ENDDO
        163 |      ELSE
        164 |        WRITE(6,285)IV,JPDS(5),L,IRET
        165 |        WRITE(6,*)' COULD NOT UNPACK CNVCT PCP FROM FILE 1'
        166 |         ISTAT = IRET
        167 |        RETURN
        168 |      ENDIF
        169 |
        170 |C  SNOWFALL
        171 |      J = 0
        172 |      JPDS = -1
        173 |      JPDS(3) = IGDNUM
        174 |      JPDS(5) = 065
        175 |      JPDS(6) = 001
        176 |      JPDS(14) = FHR3
        177 |      JPDS(15) = FHR1
        178 |
        179 |      CALL GETGB(LUGB,LUGI,NUMVAL,J,JPDS,JGDS,KF,K,
        180 |     X           KPDS,KGDS,MASK,GRID,IRET)
        181 |      IF(IRET.EQ.0) THEN
        182 |        II = 1
        183 |        JJ = JJ1
        184 |        DO KK = 1, ITOT
        185 |          SNOW(KK) = GRID(KK)
        186 |        ENDDO
        187 |      ELSE
        188 |        WRITE(6,285)IV,JPDS(5),L,IRET
        189 |        WRITE(6,*)' COULD NOT UNPACK SNOW FROM FILE 1'
        190 |         ISTAT = IRET
        191 |        RETURN
        192 |      ENDIF
        193 |
        194 |
        195 |C BEGIN WORK ON 2ND FILE
        196 |      JJ1 = 1
        197 |      JJINC = 1
        198 |
        199 |C  READ INDEX FILE TO GET GRID SPECS
        200 |C
        201 |      IRGI = 1
        202 |      IRGS = 1
        203 |      KMAX = 0
        204 |      JR=0
        205 |      KSKIP = 0
        206 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB2
        207 |      CALL GETENV(ENVVAR,FNAME)
        208 |      CALL BAOPEN(LUGB2,FNAME,IRETGB2)
        209 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGI2
        210 |      CALL GETENV(ENVVAR,FNAME)
        211 |      CALL BAOPEN(LUGI2,FNAME,IRETGI2)
        212 |      CALL GETGI(LUGI2,KSKIP,MBUF,CBUF2,NLEN,NNUM,IRGI)
        213 |      IF(IRGI .NE. 0) THEN
        214 |        WRITE(6,*)' PROBLEMS READING GRIB INDEX FILE SO ABORT'
        215 |        ISTAT = IRGI
        216 |        RETURN
        217 |      ENDIF
        218 |c      REWIND LUGI2
        219 |
        220 |      DO K = 1, NNUM
        221 |        JR = K - 1
        222 |        JPDS = -1
        223 |        JGDS = -1
        224 |        CALL GETGB1S(CBUF2,NLEN,NNUM,JR,JPDS,JGDS,JENS,
        225 |     &               KR,KPDS,KGDS,KENS,LSKIP,LGRIB,IRGS)
        226 |        write(6,*)' IRET FROM GETGB1S ',IRGS
        227 |        IF(IRGI .NE. 0) THEN
        228 |          WRITE(6,*)' PROBLEMS ON 1ST READ OF GRIB FILE SO ABORT'
        229 |          ISTAT = IRGS
        230 |          RETURN
        231 |        ENDIF
        232 |C
        233 |      ENDDO
        234 |
        235 |C    GET GRID NUMBER FROM PDS
        236 |C
        237 |      IGDNUM = KPDS(3)
        238 |C
        239 |C   PROCESS THE GRIB FILE
        240 |C
        241 |      IMAX = KGDS(2)
        242 |      JMAX = KGDS(3)
        243 |      NUMVAL = IMAX*JMAX
        244 |      KMAX = MAXLEV
        245 |      WRITE(6,280) IMAX,JMAX,NUMLEV,KMAX
        246 |
        247 |C -== GET SURFACE FIELDS ==-
        248 |      L = 0
        249 |      IV= 0
        250 |C   ACCUMULATED PRECIP
        251 |
        252 |c   to start each new file with its index, set J=-1 for sfc pressure
        253 |C
        254 |C
        255 |      J = -1
        256 |      JPDS = -1
        257 |      JPDS(3) = IGDNUM
        258 |      JPDS(5) = 061
        259 |      JPDS(6) = 001
        260 |      JPDS(13) = 1
        261 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        262 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        263 |      IF(IRET.EQ.0) THEN
        264 |        II = 1
        265 |        JJ = JJ1
        266 |        DO KK = 1, ITOT
        267 |          APCP2(KK) = GRID(KK)
        268 |        ENDDO
        269 |      ELSE
        270 |        WRITE(6,285)IV,JPDS(5),L,IRET
        271 |        WRITE(6,*)' COULD NOT UNPACK PCP 2ND GRID FILE '
        272 |         ISTAT = IRET
        273 |        RETURN
        274 |      ENDIF
        275 |
        276 |C   ACCUMULATED CONVECTIVE PRECIP
        277 |      J = -1
        278 |      JPDS = -1
        279 |      JPDS(3) = IGDNUM
        280 |      JPDS(5) = 063
        281 |      JPDS(6) = 001
        282 |      JPDS(13) = 1
        283 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        284 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        285 |      IF(IRET.EQ.0) THEN
        286 |        II = 1
        287 |        JJ = JJ1
        288 |        DO KK = 1, ITOT
        289 |          CAPCP2(KK) = GRID(KK)
        290 |        ENDDO
        291 |      ELSE
        292 |        WRITE(6,285)IV,JPDS(5),L,IRET
        293 |        WRITE(6,*)' COULD NOT UNPACK CPCP 2ND GRID FILE '
        294 |         ISTAT = IRET
        295 |        RETURN
        296 |      ENDIF
        297 |
        298 |C   SNOWFALL
        299 |      J = -1
        300 |      JPDS = -1
        301 |      JPDS(3) = IGDNUM
        302 |      JPDS(5) = 065
        303 |      JPDS(6) = 001
        304 |      JPDS(14) = FHR3
        305 |      JPDS(15) = FHR2
        306 |      CALL GETGB(LUGB2,LUGI2,NUMVAL,J,JPDS,JGDS,KF,K,
        307 |     X           KPDS,KGDS,MASK2,GRID,IRET)
        308 |      IF(IRET.EQ.0) THEN
        309 |        II = 1
        310 |        JJ = JJ1
        311 |        DO KK = 1, ITOT
        312 |          SNOW2(KK) = GRID(KK)
        313 |        ENDDO
        314 |      ELSE
        315 |        WRITE(6,285)IV,JPDS(5),L,IRET
        316 |        WRITE(6,*)' COULD NOT UNPACK SNOW 2ND GRID FILE '
        317 |         ISTAT = IRET
        318 |        RETURN
        319 |      ENDIF
        320 |
        321 |       DO K = 1, ITOT
        322 |          APCP3HR(K)=APCP2(K)-APCP(K)
        323 |          CAPCP3HR(K)=CAPCP2(K)-CAPCP(K)
        324 |          SNOW3HR(K)=SNOW2(K)-SNOW(K)
        325 |       ENDDO
        326 |
        327 |      KPDS(5)=61
        328 |      KPDS(14)=FHR1
        329 |      KPDS(15)=FHR2
        330 |      ENVVAR='XLFUNIT_   '
        331 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB3
        332 |      CALL GETENV(ENVVAR,FNAME)
        333 |      CALL BAOPEN(LUGB3,FNAME,IRET)
        334 |      CALL PUTGB(LUGB3,ITOT,KPDS,KGDS,MASK2,APCP3HR,IRET)
        335 |      CALL BACLOSE(LUGB3,IRET)
        336 |
        337 |      KPDS(5)=63
        338 |      KPDS(14)=FHR1
        339 |      KPDS(15)=FHR2
        340 |      ENVVAR='XLFUNIT_   '
        341 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB4
        342 |      CALL GETENV(ENVVAR,FNAME)
        343 |      CALL BAOPEN(LUGB4,FNAME,IRET)
        344 |      CALL PUTGB(LUGB4,ITOT,KPDS,KGDS,MASK2,CAPCP3HR,IRET)
        345 |      CALL BACLOSE(LUGB4,IRET)
        346 |
        347 |      KPDS(5)=65
        348 |      KPDS(14)=FHR1
        349 |      KPDS(15)=FHR2
        350 |      ENVVAR='XLFUNIT_   '
        351 |      WRITE(ENVVAR(9:10),FMT='(I2)') LUGB5
        352 |      CALL GETENV(ENVVAR,FNAME)
        353 |      CALL BAOPEN(LUGB5,FNAME,IRET)
        354 |      CALL PUTGB(LUGB5,ITOT,KPDS,KGDS,MASK2,SNOW3HR,IRET)
        355 |      CALL BACLOSE(LUGB5,IRET)
        356 |      STOP
        357 |      END
 
