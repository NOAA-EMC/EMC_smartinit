####typeset -Z2 strhr endhrs cyc avghr fhr incr

export mdlin="${mdlin[*]}"
export reg=${reg[*]}

. /nwprod/gempak/.gempak >/dev/null 2>&1

cp $scrdir/*nts $wkdir
rm -f $wkdir/ftpdone

let ivarb=0
for VARB in ${varblist[*]};do 
  if [ -z "${glvllist[ivarb]}" ];then
    export glevel=${glvllist[0]}
  else
    export glevel=${glvllist[ivarb]}
  fi
  vhdr=`echo $VARB |cut -c1-4`
  let fhr=$strhr
  export cyc
  export VARB
  export glevel

  while [ $fhr -le $endhrs ];do 
    export fhr
    echo;echo Creating $VARB smart diff plots for ${reg} cyc $cyc $yyyymmdd FHR $fhr 
    echo "PLOTAREA = $plotarea"
    $scrdir/plotdiff.sh
    ((fhr=fhr+incr))
  done
  ((ivarb=ivarb+1))
done
cd $wkdir
echo `date` >ftpdone

