#BSUB -o /ptmp/Jeff.McQueen/com/output/prod/today/sref_gefs2sref.o%J
#BSUB -e /ptmp/Jeff.McQueen/com/output/prod/today/sref_gefs2sref.o%J
#BSUB -L /bin/ksh   #moved from sh to ksh
#BSUB -q dev
#BSUB -cwd /stmp/Jeff.McQueen/tmpnwprd
#BSUB -R "span[ptile=8]"  #jtm or 16 if using all tasks on node
#BSUB -n 43               #jtm Depends on the number of forecast hours, 43 nodes for 126 fhrs
