#=====================================================================================
# This ecflow script combines all jsref_wrf_gefsprep_p##_CC.ecf and jsref_gefs2sref_CC.ecf scripts
# jsref_wrf_gefsprep creates the global gens pgrb files.
# These are input to JSREF_GEFS2SREF JOB to create gens lookalike files and products in SREF form.
# The GENS product files are then used by NAM_SMART (DNG) to downscale probability of precip 
# if SREF is missing or for DGEX downscaling beyond 87 forecast hours

# NOTE: NCO should set sref cyc below (03,09,15, 21) 
# 12-17-2013  Jeff McQueen NCEP/EMC
#=====================================================================================
# %include "/ecf/ecfnets/scripts/head.h"
#NCO set -x

# jtm lib loads
export stutil=/hwrf/noscrub/soft/modulefiles
. /usrx/local/Modules/3.2.9/init/ksh
module load ibmpe lsf ics
module use $stutil
module load ruby emc-utils


export LD_PRELOAD=/u/James.A.Abeles/mpi_trace_linux_x86_64/shared/libmpitrace.so

#  envir and cyc should be set by NCO
export envir=para
SIVER="v3.2.3"
nwdir=${nwdir:-/meso/save/${USER}/smartinit.$SIVER}  # or nwprod
export utilscript=${utilscript:-/nwprod/util/ush}
$utilscript/setup.sh
export DATE=PDY
outd=${outd:-/ptmp/Jeff.McQueen/com/sref/prod/sref.$DATE}

# Determine cycle (NCO WILL SET)
let HH=`date +%H`
if [ $HH -ge 01 -a $HH -le 06 ];then export cyc=00;
elif [ $HH -le 12 ];then export cyc=06;
elif [ $HH -le 18 ];then export cyc=12;
else
  export cyc=18
fi
export cyc=06   #TEST

#  PURPOSE:      To execute the SREF Post Procestep must line up to the number job  submissions
#  Set NODES: (e.g.: 90/3 +1=31)
export ENDHOUR=90
export INCHOUR=3
export INCR=${INCHOUR}
export CYC=${cyc}
export LENGTH=${ENDHOUR}
export DATE=$PDY
export TOTAL_COUNT=`expr $LENGTH / $INCR + 1`

# versions file for SREF model $model_ver
VERSION_FILE=/nw${envir}/versions/sref.ver
if [ -f $VERSION_FILE ]; then
  . $VERSION_FILE
else
  exit
fi
#=======================================================
#1. jtm  Create SREF look-alike files from GEFS run
#=======================================================
for MEMBER in c00 ctl;do
  export MEMBER
  export job=sref_wrf_gefsprep_${MEMBER}_${cyc}
#TEST  ${nwdir}/jobs/JSREF_WRF_GFSPREP
done

ipert=01
while [ $ipert -le 20 ];do
  export MEMBER="p${ipert}"
  export job=sref_wrf_gefsprep_${MEMBER}_${cyc}
#TEST  ${nwdir}/jobs/JSREF_WRF_GFSPREP
  ipert=`expr $ipert + 1`
  if [ $ipert -lt 10 ];then ipert=0${ipert};fi
done

# wait for completion of gefs pgrb file creation  (NCO make separate ecflow script)
if [ ! -s "$outd/global_pgrb/gens_p20.t{cyc}z.pgrbf${LENGTH}" ];then
  sleep 60
fi

#=======================================================
#2. Create SREF look-alike products from GEFS run
#=======================================================
export job=sref_gefs2sref
${nwdir}/jobs/JSREF_GEFS2SREF

# if [ $? -ne 0 ]; then
#  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
#  ecflow_client --abort
#  exit
# fi


