#PBS -N smartinit_%grid%_f%FHR%_%CYC%
#PBS -j oe
#PBS -S /bin/bash
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:45:00
#PBS -l select=1:ncpus=%NCPUS%:mem=%MEM%:prepost=%PREPOST%
##PBS -l place=shared:vscatter,select=1:ncpus=%NCPUS%:mpiprocs=%NCPUS%:ompthreads=1:mem=%MEM%:prepost=%PREPOST%
#PBS -l debug=true

export model=smartinit

%include <head.h>
%include <envir-p1.h>

# EXPORT list here

export job=nam_sminit_%grid%_f%FHR%_%CYC%
export cyc=%CYC%
export ffhr=%FHR%
export RUNTYP=%RUNTYP%

export NTASKS=%NCPUS%
export CFP=%CFP%

module load PrgEnv-intel/$PrgEnv_intel_ver
module load intel/$intel_ver
module load libjpeg/$libjpeg_ver
module load grib_util/${grib_util_ver:?}
module load wgrib2/$wgrib2_ver
# CFP does not work with KMP_AFFINITY=disabled.
# uncomment or delete when GDIT responds
#if [ $CFP = 'YES' ]; then
#  module load craype/$craype_ver
#  module load cray-mpich/$cray_mpich_ver
#  module load cray-pals/$cray_pals_ver
#  module load cfp/$cfp_version
#fi
module list

env

# CALL executable job script here
${HOMEsmartinit}/jobs/JSMARTINIT

if [ $? -ne 0 ]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
  ecflow_client --abort
  exit
fi

%include <tail.h>
%manual
######################################################################
# Purpose:  To execute the job that runs NAM postprocessing for the
#           forecast hour.
######################################################################

######################################################################
# Job specific troubleshooting instructions:
#  see generic troubleshoot manual page
