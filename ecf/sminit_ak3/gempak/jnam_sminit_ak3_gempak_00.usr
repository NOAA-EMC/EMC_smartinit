%comment - ecf user variables
DUMMYVAR:4_ecflow_edit_only = 4_ecflow_edit_only
ECF_VERSION = 3.1.2
%end - ecf user variables
#BSUB -J jnam_sminit_ak3_gempak_00
#BSUB -o /com/output/prod/today/nam_sminit_ak3_gempak_00.o%J
#BSUB -e /com/output/prod/today/nam_sminit_ak3_gempak_00.o%J
